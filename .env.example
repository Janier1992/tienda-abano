# Copiar a .env.local y completar. Sin estas variables la tienda muestra estados "pendiente de configuración".

# URL pública del sitio (enlaces de acceso por correo)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer al navegador ni subir al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Asistente virtual (OpenRouter). Sin clave, el asistente se muestra como no disponible.
OPENROUTER_API_KEY=
ASSISTANT_MODEL=anthropic/claude-sonnet-4.5

# Modo prototipo (solo presentaciones): contenido ilustrativo si no hay Supabase. Nunca en producción.
NEXT_PUBLIC_DEMO_MODE=false
